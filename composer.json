{
    "name": "pieceofcake2/totp",
    "description": "Two-factor authentication with time-based one-time passwords (TOTP, RFC 6238) for the CakePHP 2 AuthComponent",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "authenticate", "2fa", "two-factor", "totp", "otp", "google-authenticator"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12",
        "pragmarx/google2fa": "^9.0"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^2.0 || ^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Required by TotpHelper::qrCode() to render the QR code (^2.0 || ^3.0)"
    },
    "replace": {
        "ceeram/google-authenticate": "*"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Totp"
    }
}
